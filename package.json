{
  "name": "echoes-of-burbenog",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "predev": "npm run build:assets",
    "dev": "vite",
    "prebuild": "npm run build:assets",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "build:assets": "tsx scripts/build-assets.ts --write",
    "test": "npm run test:core && npm run test:assets && playwright test",
    "test:core": "tsx scripts/check-simulation.ts",
    "test:assets": "tsx scripts/build-assets.ts --test",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.2",
    "@types/three": "^0.186.0",
    "typescript": "^7.0.2",
    "tsx": "^4.23.15",
    "vite": "^8.3.1"
  }
}
